# Cobertura Territorial — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# OpenRouteService API Key (obrigatório para Cobertura Logística)
# Chave gratuita em: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_ors_api_key_here

# Provedor de roteamento (padrão: ors)
# Opções futuras: graphhopper
ROUTING_PROVIDER=ors
